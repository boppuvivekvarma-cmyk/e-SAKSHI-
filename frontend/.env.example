# ──────────────────────────────────────────────────────────
# e-SAKSHI 2.0 Sentinel — Environment Variables
# ──────────────────────────────────────────────────────────
#
# OPTIONAL: If you deploy the FastAPI backend to Railway/Render/fly.io,
# set this to the backend's public URL.
# Leave empty to run in full mock-data mode (works perfectly on Vercel).
#
# Example:
#   NEXT_PUBLIC_BACKEND_URL=https://esakshi-backend.railway.app
#
NEXT_PUBLIC_BACKEND_URL=

# Auto-set by Vercel — do NOT set this manually:
# VERCEL_URL=your-deployment.vercel.app
